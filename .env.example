# ==============================================================================
# MountYourClouds — Production & Local Development Environment Configuration
# Never commit real credentials, client secrets, or private keys to source control!
# ==============================================================================

# Core Application & Networking
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Cryptographic Security (Mandatory for Token Encryption & OAuth State Defense)
# ------------------------------------------------------------------------------
# OAUTH_ENCRYPTION_KEY: 64-character (32 bytes) hex string used for AES-256-GCM
# encryption of OAuth refresh tokens at rest.
# Generate on Linux/macOS via: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SESSION_SECRET: High-entropy string used for HMAC-SHA256 signing of OAuth state
# parameters to prevent CSRF and clickjacking attacks.
# Generate via: openssl rand -base64 32
SESSION_SECRET=your_super_secret_session_signing_key_change_in_production_32b

# Optional Gemini AI studio key for AI-assisted file classification and analysis
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyPlaceholder

# ==============================================================================
# Phase 1: Primary OAuth 2.0 Providers (PKCE + Server-Side Authorization Code)
# ==============================================================================

# 1. Google Drive (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized Redirect URI: http://localhost:3000/api/oauth/callback
# Scopes: https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/drive.readonly
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# 2. Microsoft OneDrive / Graph (Azure Portal -> Microsoft Entra -> App Registrations)
# Authorized Redirect URI: http://localhost:3000/api/oauth/callback (Web platform)
# Scopes: Files.ReadWrite User.Read offline_access
MICROSOFT_ONEDRIVE_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_ONEDRIVE_CLIENT_SECRET=your_microsoft_entra_client_secret_value

# 3. Dropbox (Dropbox App Console -> Create App -> Scoped access)
# Authorized Redirect URI: http://localhost:3000/api/oauth/callback
# Scopes: files.metadata.read files.content.read files.content.write
DROPBOX_CLIENT_ID=your_dropbox_app_key
DROPBOX_CLIENT_SECRET=your_dropbox_app_secret

# ==============================================================================
# Phase 2: Secondary OAuth 2.0 Providers
# ==============================================================================

# 4. Box (Box Developer Console -> Custom App -> User Authentication OAuth 2.0)
# Authorized Redirect URI: http://localhost:3000/api/oauth/callback
# Scopes: root_readwrite
BOX_CLIENT_ID=your_box_client_id
BOX_CLIENT_SECRET=your_box_client_secret

# 5. pCloud (pCloud Developer Console -> My Apps)
# Authorized Redirect URI: http://localhost:3000/api/oauth/callback
PCLOUD_CLIENT_ID=your_pcloud_client_id
PCLOUD_CLIENT_SECRET=your_pcloud_client_secret

# ==============================================================================
# Phase 3: Object Storage & Protocol Providers (Direct API Credentials)
# ==============================================================================

# AWS S3 / Compatible Object Storage
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=mountyourclouds-vault

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=mountyourclouds-r2-vault

# WebDAV / Nextcloud / ownCloud
WEBDAV_ENDPOINT=https://cloud.example.com/remote.php/dav/files/username
WEBDAV_USERNAME=username
WEBDAV_PASSWORD=your_app_specific_password
